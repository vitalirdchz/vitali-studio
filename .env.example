# Variables d'environnement pour Vitali Studio (Netlify)

# 1. Chaîne de connexion MongoDB Atlas (ex: mongodb+srv://vitali:<password>@cluster0.xxxxx.mongodb.net/vitali-studio?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vitali_studio?retryWrites=true&w=majority

# 2. Code secret pour le panneau d'administration (/admin)
ADMIN_ACCESS_CODE=VitaliStudio2026!
